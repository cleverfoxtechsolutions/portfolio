---
import { site } from "../data/site";
import { url } from "../lib/url";

const links = [
  { href: "#work", label: "Case files" },
  { href: "#writing", label: "Writing" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b hairline bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={url("/")} class="font-display text-xl font-bold tracking-tight text-ink">
      {site.handle}<span class="text-signal">.</span>
    </a>
    <nav class="hidden items-center gap-7 sm:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="field-label text-ink-dim transition-colors hover:text-signal"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a
      href={`mailto:${site.email}`}
      class="field-label rounded border border-line px-3 py-1.5 text-ink-dim transition-colors hover:border-signal hover:text-signal"
    >
      Contact
    </a>
  </div>
</header>
