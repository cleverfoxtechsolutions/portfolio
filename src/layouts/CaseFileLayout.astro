---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url";

interface Props {
  title: string;
  subject: string;
  vector: string;
  stack: string[];
  status: string;
}

const { title, subject, vector, stack, status } = Astro.props;
---

<Layout title={`${title} — Case File`} description={subject}>
  <Header />
  <main>
    <article class="border-b hairline">
      <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
        <a
          href={`${url("/")}#work`}
          class="field-label mb-10 inline-flex items-center gap-1.5 text-ink-dim transition-colors hover:text-signal"
        >
          ← Back to case files
        </a>

        <p class="field-label mb-3 text-signal">// case file</p>
        <h1 class="font-display text-4xl font-bold leading-[0.95] text-ink sm:text-6xl">
          {title}
        </h1>
        <p class="mt-4 max-w-xl text-lg text-ink-dim">{subject}</p>

        <dl class="mt-10 grid grid-cols-1 gap-6 border-y hairline py-6 sm:grid-cols-3">
          <div>
            <dt class="field-label">Vector</dt>
            <dd class="mt-1.5 text-sm text-ink">{vector}</dd>
          </div>
          <div>
            <dt class="field-label">Stack</dt>
            <dd class="mt-1.5 text-sm text-ink">{stack.join(" · ")}</dd>
          </div>
          <div>
            <dt class="field-label">Status</dt>
            <dd class="mt-1.5 text-sm text-cold">{status}</dd>
          </div>
        </dl>

        <div
          class="prose prose-invert mt-12 max-w-none
            prose-headings:font-display prose-headings:font-bold prose-headings:text-ink
            prose-h2:mt-12 prose-h2:text-2xl
            prose-p:leading-relaxed prose-p:text-ink-dim
            prose-strong:text-ink
            prose-li:text-ink-dim
            prose-a:text-cold prose-a:no-underline hover:prose-a:text-signal
            prose-code:font-mono prose-code:text-sm prose-code:text-signal
            prose-hr:border-line"
        >
          <slot />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
